+/* Independent file diagnostics. Data writes keep vendor buffering/format. */
+#include <errno.h>
+#include <stdarg.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+
+typedef struct RunOutput {
+	FILE **slot;
+	char path[600];
+	unsigned logged;
+} RunOutput;
+enum { OUT_RAW_B, OUT_RAW_A, OUT_LIST_B, OUT_LIST_A, OUT_LIST_C,
+       OUT_SYNC_FILE, OUT_SERVICE, OUT_AUX, OUT_COUNT };
+enum { IO_OPEN = 1u, IO_WRITE = 2u, IO_FLUSH = 4u, IO_SYNC = 8u,
+       IO_CLOSE = 16u, IO_PUBLISH = 32u, IO_READ = 64u };
+static FILE *of_aux;
+static RunOutput Output[OUT_COUNT] = {
+	{ &of_raw_b }, { &of_raw_a }, { &of_list_b }, { &of_list_a },
+	{ &of_list_c }, { &of_sync }, { &of_servInfo }, { &of_aux }
+};
+static int output_failed;
+
+static int OutputError(RunOutput *o, unsigned flag, const char *action, int err)
+{
+	if (err == 0) err = EIO;
+	if (!(o->logged & flag)) {
+		fprintf(stderr, "JANUS output %s failed: %s (errno=%d: %s)\n",
+		        action, o->path[0] ? o->path : "(unknown path)", err, strerror(err));
+		o->logged |= flag;
+	}
+	output_failed = 1;
+	return -1;
+}
+
+static RunOutput *OutputFromStream(FILE *f)
+{
+	for (int i = 0; i < OUT_COUNT; ++i)
+		if (f && *Output[i].slot == f) return &Output[i];
+	return &Output[OUT_AUX];
+}
+
+static int OutputPrintf(FILE *f, const char *fmt, ...)
+{
+	if (!f) return OutputError(&Output[OUT_AUX], IO_WRITE, "write to unopened stream", EBADF);
+	va_list args;
+	va_start(args, fmt);
+	errno = 0;
+	int result = vfprintf(f, fmt, args);
+	int err = errno;
+	va_end(args);
+	return result < 0 ? OutputError(OutputFromStream(f), IO_WRITE, "write", err) : result;
+}
+
+static size_t OutputWrite(const void *p, size_t size, size_t count, FILE *f)
+{
+	if (!f) {
+		OutputError(&Output[OUT_AUX], IO_WRITE, "write to unopened stream", EBADF);
+		return 0;
+	}
+	errno = 0;
+	size_t result = fwrite(p, size, count, f);
+	if (result != count) OutputError(OutputFromStream(f), IO_WRITE, "write", errno);
+	return result;
+}
+
+static int OutputFlush(FILE *f)
+{
+	if (!f) return OutputError(&Output[OUT_AUX], IO_FLUSH, "flush unopened stream", EBADF);
+	errno = 0;
+	return fflush(f) == 0 ? 0 : OutputError(OutputFromStream(f), IO_FLUSH, "flush", errno);
+}
+
+static int OpenOutput(RunOutput *o, const char *mode, const char *fmt, ...)
+{
+	if (*o->slot) return OutputError(o, IO_OPEN, "open over active stream", EBUSY);
+	va_list a;
+	va_start(a, fmt);
+	int n = vsnprintf(o->path, sizeof(o->path), fmt, a);
+	va_end(a);
+	o->logged = 0;
+	if (n < 0 || (size_t)n >= sizeof(o->path)) {
+		o->path[sizeof(o->path) - 1] = '\0';
+		return OutputError(o, IO_OPEN, "format output path", ENAMETOOLONG);
+	}
+	errno = 0;
+	*o->slot = fopen(o->path, mode);
+	return *o->slot ? 0 : OutputError(o, IO_OPEN, "exclusive open", errno);
+}
+
+static int CloseOutput(RunOutput *o, int durable)
+{
+	FILE *f = *o->slot;
+	if (!f) return 0;
+	int ret = 0;
+	if (ferror(f) && !(o->logged & (IO_WRITE | IO_FLUSH)))
+		ret = OutputError(o, IO_WRITE, "stream error before close", EIO);
+	if (OutputFlush(f) < 0) ret = -1;
+	if (durable && ret == 0 && !(o->logged & (IO_WRITE | IO_FLUSH))) {
+		errno = 0;
+#ifdef _WIN32
+		int fd = _fileno(f);
+		if (fd < 0 || _commit(fd) != 0)
+#else
+		int fd = fileno(f);
+		if (fd < 0 || fsync(fd) != 0)
+#endif
+			ret = OutputError(o, IO_SYNC, "sync", errno);
+	}
+	*o->slot = NULL;  /* never close the same FILE twice, even if fclose fails */
+	errno = 0;
+	if (fclose(f) != 0) ret = OutputError(o, IO_CLOSE, "close", errno);
+	return o->logged != 0 ? -1 : ret;
+}
+
+static int PublishInfo(RunOutput *o, const char *final_path)
+{
+	/* Same-directory, no-replace atomic publish; keep temporary file on failure. */
+#ifdef _WIN32
+	if (!MoveFileExA(o->path, final_path, MOVEFILE_WRITE_THROUGH)) {
+		DWORD error = GetLastError();
+		fprintf(stderr, "JANUS RunInfo publish failed to %s (Win32=%lu)\n",
+		        final_path, (unsigned long)error);
+		return OutputError(o, IO_PUBLISH, "publish (partial metadata retained)",
+		                   error == ERROR_FILE_EXISTS || error == ERROR_ALREADY_EXISTS ? EEXIST : EIO);
+	}
+#else
+	if (link(o->path, final_path) != 0)
+		return OutputError(o, IO_PUBLISH, "publish (partial metadata retained)", errno);
+	if (unlink(o->path) != 0) {
+		int err = errno;
+		fprintf(stderr, "JANUS RunInfo published, but temporary name retained: %s (errno=%d)\n", o->path, err);
+	}
+#endif
+	return 0;
+}
+
+#define fprintf OutputPrintf
+#define fwrite OutputWrite
+#define fflush OutputFlush
