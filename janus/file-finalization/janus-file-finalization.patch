+
+static int OpenList(RunOutput *o, int run, int split, int shard, const char *suffix, const char *mode)
+{
+	if (run < 0) return OpenOutput(o, mode, "%slist%s", J_cfg.DataFilePath, suffix);
+	if (split) return OpenOutput(o, mode, "%sRun%d.%d_list%s", J_cfg.DataFilePath, run, shard, suffix);
+	return OpenOutput(o, mode, "%sRun%d_list%s", J_cfg.DataFilePath, run, suffix);
+}
+
+static int IncreaseListSubRun(int type)
+{
+	int index = type == 0 ? OUT_LIST_B : type == 1 ? OUT_LIST_C : OUT_LIST_A;
+	RunOutput *o = &Output[index];
+	int *seq = type == 0 ? &bin_srun : type == 1 ? &csv_srun : &ascii_srun;
+	uint64_t *size = type == 0 ? &bin_size : type == 1 ? &csv_size : &ascii_size;
+	*size = 0;
+	if (CloseOutput(o, 0) < 0) return -1;
+	if (*seq == INT_MAX) return OutputError(o, IO_OPEN, "next output segment number", ERANGE);
+	return OpenList(o, LocalRunNum, 1, ++*seq, type == 0 ? ".dat" : type == 1 ? ".csv" : ".txt", type == 0 ? "wbx" : "wx");
+}
+
+int CloseOutputFiles()
+{
+	for (int i = 0; i < OUT_COUNT; ++i) CloseOutput(&Output[i], 1);
+	bin_size = ascii_size = csv_size = 0;
+	bin_srun = ascii_srun = csv_srun = 0;
+	return output_failed ? -1 : 0;
+}
